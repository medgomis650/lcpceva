# Copy this file to .env for local dev (npm run dev), or set these as
# environment variables in your hosting provider's dashboard (Netlify/Vercel)
# before deploying. Never commit the real .env file.

# From Supabase: Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: simple shared access code for the whole app (not real security,
# just a light deterrent against casual access to the shared link).
# Leave empty / remove the line to disable.
VITE_APP_PASSCODE=
